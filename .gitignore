# Ignore everything by default so only the real project sources are tracked
*

# Keep the core application sources and documentation
!.gitignore
!README.md
!deploy_frontend.ps1
!index.html
!sw.js
!frontend/
!frontend/**

# Ignore runtime and local artifacts
.env
.venv/
.venv311/
.vscode/
*.log
*.sqlite
*.db
/var/lib/couchdb/
**/__pycache__/
.githooks/
backend/**
docs/**
changelog/**
